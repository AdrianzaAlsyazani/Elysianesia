---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content'; // Modul render baru wajib di Astro v6
import BaseLayout from '../../layouts/BaseLayout.astro';

// 1. Ambil semua file esai menggunakan standar ID Astro v6
export async function getStaticPaths() {
  const tulisanEsai = await getCollection('tulisan');
  return tulisanEsai.map((esai: CollectionEntry<'tulisan'>) => ({
    params: { slug: esai.id }, // Menggunakan id sebagai slug routing
    props: { esai },
  }));
}

interface Props {
  esai: CollectionEntry<'tulisan'>;
}

const { esai } = Astro.props;
// 2. Menggunakan fungsi render global bawaan Astro v6
const { Content } = await render(esai);
const { title, description, author, date, category, readingTime } = esai.data;
---

<BaseLayout title={title} description={description} showProgress={true}>
  <main class="max-w-3xl mx-auto px-6 py-16">
    
    <header class="mb-12">
      <div class="text-xs font-mono uppercase tracking-widest text-solar-teal font-semibold mb-3">
        {category}
      </div>
      <h1 class="text-3xl md:text-5xl font-serif font-bold leading-tight mb-4 text-slate-950">
        {title}
      </h1>
      <p class="text-xl text-slate-600 font-light italic mb-6 leading-relaxed">
        {description}
      </p>
      <div class="flex items-center space-x-3 text-xs font-mono text-solar-text/60">
        <span>Oleh {author}</span>
        <span>•</span>
        <span>{new Date(date).toLocaleDateString('id-ID', {year: 'numeric', month: 'long', day: 'numeric'})}</span>
        <span>•</span>
        <span>{readingTime}</span>
      </div>
    </header>

    <article class="prose prose-lg prose-slate font-sans max-w-none 
      prose-headings:font-serif prose-headings:text-solar-text 
      prose-p:leading-relaxed prose-p:text-slate-800
      prose-blockquote:border-l-solar-teal prose-blockquote:bg-solar-teal/5 prose-blockquote:py-1 prose-blockquote:rounded-r">
      <Content />
    </article>

  </main>
</BaseLayout>